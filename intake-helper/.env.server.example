# 공유 서버용 설정 예시. 이 파일을 .env 로 복사해서 쓰세요(install.sh / install.ps1 이 자동으로 만들어 줍니다).
# .env 는 다른 사람과 공유하거나 저장소에 올리지 마세요.

# ── 열기 ────────────────────────────────────────────
# 0.0.0.0 이면 같은 망의 다른 PC 가 접속할 수 있습니다. 127.0.0.1 이면 이 서버 안에서만(프록시 뒤에 둘 때) 열립니다.
HOST=0.0.0.0
PORT=8791
# 사용자가 브라우저에 입력하는 주소 (경로 없이). Host/Origin 검사와 안내에 쓰입니다.
PUBLIC_URL=https://intake.example.go.kr
# 위 주소 말고 접속을 허용할 주소가 더 있으면 쉼표로 (예: 10.0.0.5:8791)
# ALLOWED_HOSTS=

# ── 접속 제한 (공유 서버에서는 접속 비밀번호가 필수) ───
# 8자 이상. 고객지원팀에만 알려 주세요. 5번 틀리면 그 IP 는 10분간 막힙니다.
ACCESS_PASSWORD=
# 접속을 허용할 IP 또는 대역(쉼표 구분, IPv4). 비우면 제한 없음. 예: 10.20.0.0/24,10.20.1.15
ALLOWED_IPS=
# 연결을 허용할 사번(쉼표 구분). 비우면 어떤 사번이든 연결 가능. 고객지원팀 사번만 적어 두는 것을 권장합니다.
ALLOWED_EMPLOYEES=

# ── HTTPS ───────────────────────────────────────────
# 방법 1) 이 프로그램이 직접 HTTPS 로 열기: 인증서 파일 경로를 적습니다.
# TLS_CERT=certs/server.crt
# TLS_KEY=certs/server.key
# 방법 2) nginx 같은 HTTPS 프록시 뒤에 두기: 아래를 1로 하고 HOST=127.0.0.1 로 합니다.
#         프록시는 X-Forwarded-For 를 접속자 IP 로 덮어써서 전달해야 합니다(deploy/nginx.conf.example 참고).
# TRUST_PROXY=1

# ── 운영 ────────────────────────────────────────────
# 사용하지 않고 이 시간이 지나면 접속이 풀립니다.
SESSION_HOURS=8
# 한 번에 올릴 수 있는 파일 크기 합계(MB)
MAX_UPLOAD_MB=60
# 접속 기록(사번, 시각, IP, 동작만. 의뢰서 내용은 남기지 않음)을 저장할 폴더
LOG_DIR=logs

# ── 연구관리시스템·AI ──────────────────────────────
# KAFRI_BASE_URL=https://kafri.kfia.or.kr:8444/kfia
# KAFRI_INSECURE_TLS=0
# 사진·스캔을 서버가 직접 AI 로 읽게 하려면(선택). 이 서버를 쓰는 모든 사람의 사용량이 이 키로 청구됩니다.
ANTHROPIC_API_KEY=
